# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# DATABASE
# Supabase provides both of these; directUrl bypasses PgBouncer for migrations
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/unitree_shop?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/unitree_shop

# ─────────────────────────────────────────────
# JWT
# Generate secrets: openssl rand -base64 64
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ─────────────────────────────────────────────
# OAUTH
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────
# STRIPE
# Use test keys in development; never commit live keys
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─────────────────────────────────────────────
# REDIS (Upstash for serverless, local Redis for dev)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# EMAIL (Resend recommended — clean API, good deliverability)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@unitreerobotics.com

# ─────────────────────────────────────────────
# STORAGE (Cloudflare R2 — S3-compatible, no egress fees)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=unitree-assets
R2_PUBLIC_URL=https://assets.unitreerobotics.com

# ─────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────
SENTRY_DSN=
